# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
ImpunityUnity/[Ll]ibrary/
ImpunityUnity/[Tt]emp/
ImpunityUnity/[Oo]bj/
ImpunityUnity/[Ll]ogs/
ImpunityUnity/[Uu]ser[Ss]ettings/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
ImpunityUnity/[Mm]emoryCaptures/

# Recordings can get excessive in size
ImpunityUnity/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
ImpunityUnity/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
ImpunityUnity/.vs/
ImpunityUnity/.vscode

# Gradle cache directory
ImpunityUnity/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ImpunityUnity/ExportedObj/
ImpunityUnity/.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
ImpunityUnity/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
ImpunityUnity/crashlytics-build.properties

# Packed Addressables
ImpunityUnity/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
ImpunityUnity/[Aa]ssets/[Ss]treamingAssets/aa.meta
ImpunityUnity/[Aa]ssets/[Ss]treamingAssets/aa/*


# Server ignores

